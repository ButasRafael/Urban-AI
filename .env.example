# Security & JWT
SECRET_KEY=your-secret-key-here
ACCESS_EXPIRE_MIN=60                # minutes   (1 h)
REFRESH_EXPIRE_MIN=10080            # minutes   (7 days)
ALGORITHM=HS256                     # JWT algorithm

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/urban_ai

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here
ENVIRONMENT=development
RELEASE=1.0.0

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# DeepDataSpace
DDS_TOKEN=your-dds-token-here
DDS_API=https://api.deepdataspace.com

# Celery & Redis Configuration
REDIS_PASSWORD=your-redis-password-here
CELERY_BROKER_URL=redis://:your-redis-password-here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password-here@redis:6379/1

# Email Configuration (MailHog for Development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@urbanai.com

# Frontend URLs (for email links)
WEB_APP_URL=https://urban-ai-dae31.web.app
MOBILE_APP_SCHEME=urbanai

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com

# Firebase Admin SDK (for Push Notifications)
# Option 1: Path to service account JSON file (recommended for development)
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# Option 2: Service account JSON as string (recommended for production/Docker)
# Get this from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as a single-line string
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project-id",...}'